meta {
  name: CL-11 · Nombre con solo espacios
  type: http
  seq: 5
}

post {
  url: {{host}}/transacciones
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  { "comercio_id": 1, "cliente_nombre": "     ", "monto": 25.50 }
}

tests {
  test("CL-11 responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  
  test("CL-11 el error está en cliente_nombre", function () {
    expect(res.getBody().errors).to.have.property("cliente_nombre");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
