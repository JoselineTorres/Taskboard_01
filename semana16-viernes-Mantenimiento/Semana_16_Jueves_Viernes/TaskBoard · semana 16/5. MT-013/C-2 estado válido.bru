meta {
  name: C-2 estado válido
  type: http
  seq: 2
}

get {
  url: {{host}}/transacciones?estado=Completada
  body: none
  auth: inherit
}

params:query {
  estado: Completada
}

headers {
  Accept: application/json
}

tests {
  test("C-2 responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("C-2 solo hay Completadas", function () {
    const estados = res.getBody().data.map(t => t.estado);
    expect(estados.every(e => e === "Completada")).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
