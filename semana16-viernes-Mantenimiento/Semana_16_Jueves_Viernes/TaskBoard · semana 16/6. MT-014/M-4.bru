meta {
  name: M-4
  type: http
  seq: 4
}

get {
  url: {{host}}/transacciones/filtrar?monto_min=-5
  body: none
  auth: inherit
}

params:query {
  monto_min: -5
}

headers {
  Accept: application/json
}

tests {
  test("M-4 responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  
  test("M-4 el error está en monto_min", function () {
    expect(res.getBody().errors).to.have.property("monto_min");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
