meta {
  name: M-7
  type: http
  seq: 7
}

get {
  url: {{host}}/transacciones/filtrar?monto_max=0
  body: none
  auth: inherit
}

params:query {
  monto_max: 0
}

headers {
  Accept: application/json
}

tests {
  test("M-7 monto_max=0 devuelve lista vacía", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.length).to.equal(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
